# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Veyron PHP Custom Framework"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://veyron.local

# ---------------------------------------------------------------------------
# Database (used from Phase 2 onward)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=javascript
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_VERSION=v1

# Number of days an API token stays valid after it is issued.
# JWTs share this lifetime.
API_TOKEN_EXPIRY_DAYS=30

# Secret used to sign JWTs (HS256). REQUIRED for JWT auth; when empty only
# legacy opaque tokens are issued. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=

# ---------------------------------------------------------------------------
# CORS (used from a later phase)
# Comma separated list of allowed frontend origins.
# Do NOT use "*" together with token authentication.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500